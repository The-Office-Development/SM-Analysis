# ---------------------------------------------------------------------------
# PulseBoard environment variables
# Copy to .env.local for local dev; set the same keys in Netlify → Site
# configuration → Environment variables for production.
# ---------------------------------------------------------------------------

# --- Frontend (safe to expose; must be prefixed VITE_) ---------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Public base URL of the deployed site (used to build OAuth redirect URIs).
# Local: http://localhost:8888   Production: https://your-site.netlify.app
VITE_SITE_URL=http://localhost:8888

# --- Backend only (NEVER prefixed with VITE_, never sent to the browser) ---
# Supabase service role key — full DB access, used only inside Netlify Functions.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Meta (Facebook + Instagram Graph API) app credentials.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# TikTok for Developers app credentials.
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Random 32+ char string used to sign OAuth state tokens.
OAUTH_STATE_SECRET=change-me-to-a-long-random-string

# Anthropic API key — powers the AI Assistant (/api/ai). Optional: if unset,
# the Assistant shows a "not configured" message and the rest of the app works.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Added by the pre-launch audit ---------------------------------------
# 32 random bytes, base64. Encrypts platform access tokens at rest so a leaked
# database snapshot is not a set of live credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED. There is deliberately no default.
TOKEN_ENC_KEY=

# REQUIRED. Signs the OAuth state. There is deliberately no fallback: a default
# published in this repository would let anyone forge a state for any user.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=

# Optional. Graph API version, pinned in one place. v19.0 expired 21 May 2026.
META_GRAPH_VERSION=v25.0

# --- Instagram API with Instagram Login (the primary connection path) -----
# From the Instagram app in your Meta app dashboard: Products -> Instagram ->
# API setup with Instagram login. NOT the same as META_APP_ID/SECRET, which
# belong to the Facebook Login path used for Facebook Pages.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Optional. Instagram Login API version.
IG_API_VERSION=v23.0
