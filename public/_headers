# Security headers, carried over from netlify.toml verbatim.
# None of these existed before the audit: no CSP, no HSTS, no nosniff and no
# referrer policy on a site holding platform credentials.
#
# Tightened 2026-09-19 after the first OWASP ZAP scan (docs/security/):
#  - style-src lost 'unsafe-inline' and img-src lost `https:`. The app renders
#    no external image at all, and React sets styles through the DOM, which CSP
#    does not restrict. Proven before shipping: every page, both modes, served
#    locally under this policy with zero violations, and a deliberately broken
#    policy as the control (128 violations, so the detector works).
#  - Cross-Origin-Opener-Policy: sign-in flows are full-page redirects, never
#    popups, so nothing needs a cross-origin opener.
#  - `! Access-Control-Allow-Origin` detaches Cloudflare's default `*`. Nothing
#    reads this site cross-origin.
# If an external image is ever shown (an avatar), add its CDN host to img-src
# by name; do not put `https:` back.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cross-Origin-Opener-Policy: same-origin
  ! Access-Control-Allow-Origin

# Public report pages are shared deliberately; they should not be indexed.
/r/*
  X-Robots-Tag: noindex, nofollow
